# ============================================================
# FAST PAGE PRO — Sanity Environment Variables
# Copia este archivo como .env.local y llena los valores
# ============================================================

# ── Sanity.io (obligatorio) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=95d9zjqb
NEXT_PUBLIC_SANITY_DATASET=production

# ── Token de lectura para Draft Mode / Live Preview ──
# Generar en: sanity.io/manage → API → Tokens → New Token
# Permisos necesarios: Reader (acceso a documentos draft)
SANITY_API_READ_TOKEN=

# ── Fast Page Pro — Configuración dinámica del Studio ──
# El título del Studio se lee desde esta variable (reutilizable)
NEXT_PUBLIC_COMPANY_NAME=Sematelmed

# ── URLs del proyecto ──
NEXT_PUBLIC_SITE_URL=https://sematelmed.vercel.app
